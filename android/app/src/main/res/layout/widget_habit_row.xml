<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_btn"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/habit_mark"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="○"
        android:textColor="#FFE14A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/habit_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4F4F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/habit_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:textColor="#A1A1AA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/habit_minus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="−"
        android:textColor="#F4F4F5"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/habit_plus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#F4F4F5"
        android:textSize="18sp" />
</LinearLayout>
