<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="HABITS"
        android:textAllCaps="true"
        android:textColor="#A1A1AA"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/habit_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Open Vesper"
        android:textColor="#F4F4F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/habit_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_btn"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#F4F4F5"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/habit_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_btn"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#F4F4F5"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/habit_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_btn"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#A1A1AA"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
