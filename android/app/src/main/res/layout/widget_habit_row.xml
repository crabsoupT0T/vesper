<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_btn"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/habit_mark"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="□"
        android:textColor="#FFE14A"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/habit_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4F4F5"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/habit_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:textColor="#A1A1AA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/habit_minus"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="−"
        android:textColor="#F4F4F5"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/habit_plus"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#F4F4F5"
        android:textSize="20sp" />
</LinearLayout>
